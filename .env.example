# SatyaCheck Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file must NOT be committed to version control.

# ── Gemini API (required for claim extraction and verdict validation) ──────────
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the default model (gemini-1.5-flash-latest)
# GEMINI_MODEL=gemini-1.5-pro-latest

# ── Search provider (at least one required for live evidence retrieval) ────────

# Option A: Brave Search API  https://api.search.brave.com/
# Free tier: 2,000 queries/month
BRAVE_SEARCH_API_KEY=

# Option B: Google Custom Search  https://programmablesearchengine.google.com/
# Free tier: 100 queries/day
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# ── Server configuration ───────────────────────────────────────────────────────
# Port for uvicorn (default: 8000)
# PORT=8000

# CORS: set to your deployed frontend URL in production
# FRONTEND_URL=https://satyacheck.in
