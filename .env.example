# SatyaCheck local development configuration
# Copy this template to .env in the project root and fill in your own keys.
# Never commit .env or share its contents.

# Gemini is required by the current verification pipeline.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional Gemini model override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-1.5-pro-latest

# Optional local Ollama fallback, used after a Gemini quota/rate-limit error.
# Ollama must be running and the model must already be installed.
# Defaults: http://localhost:11434 and qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Configure at least one search provider for live evidence retrieval.
# If multiple are configured, selection order is Brave, Google CSE, then Tavily.

# Brave Search API: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Google Custom Search: https://programmablesearchengine.google.com/
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# Tavily Search API: https://app.tavily.com/
TAVILY_API_KEY=

# Backend server settings
# Port for uvicorn (default: 8000; set PORT only if your launch command uses it)
# PORT=8000

# For a frontend hosted on a different origin, set its origin here.
# FRONTEND_URL=https://satyacheck.in
